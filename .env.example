# Mot de passe pour ouvrir kawna (obligatoire une fois en ligne)
KAWNA_PASSWORD=

# Fuseau horaire pour le mode soir et le budget du jour
KAWNA_TZ=Europe/Paris

# Claude : trie et recommande. Sans clé, kawna utilise des règles simples.
ANTHROPIC_API_KEY=
# Modèle utilisé pour composer les éditions (par défaut claude-opus-5-5)
KAWNA_MODEL=

# Stockage partagé entre appareils (Upstash Redis, offre gratuite).
# Sans ces variables, kawna écrit dans .data/kawna.json (pratique en local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connexion à ton compte YouTube (lecture seule), via Google Cloud. Voir le README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel, seulement sans compte connecté : durée des vidéos YouTube
YOUTUBE_API_KEY=

# Films et séries : affiches, catalogue de tes abonnements, « où regarder » (TMDB, gratuit). Voir le README.
TMDB_API_KEY=
# Région de tes abonnements (par défaut FR)
KAWNA_REGION=

# Trakt : ta liste, ce que tu as vu, tes notes (gratuit). Voir le README.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Protège /api/refresh quand il est appelé par le cron Vercel
CRON_SECRET=
